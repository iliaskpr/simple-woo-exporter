# WooCommerce REST API
WOO_URL=https://store.example.com
WOO_CONSUMER_KEY=ck_replace_me
WOO_CONSUMER_SECRET=cs_replace_me

# Choose WOO_SINCE or the start/end pair.
WOO_SINCE=2026-01-01
# WOO_START_DATE=2026-01-01
# WOO_END_DATE=2026-01-31

# Optional comma-separated values, such as cancelled,failed
WOO_EXCLUDED_STATUSES=
# Example: _tracking_number,_delivery_date
WOO_CUSTOM_META=
WOO_OUTPUT=orders.csv
